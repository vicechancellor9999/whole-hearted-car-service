{
  "name": "whole-hearted-formal-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "UNIFIED_NEXT_MODE=dev tsx scripts/dev-unified.ts",
    "dev:backend": "tsx scripts/dev-local.ts",
    "dev:legacy-backend": "tsx scripts/dev-local.ts",
    "dev:web": "pnpm --dir apps/web exec next dev -p 3210",
    "dev:local": "UNIFIED_NEXT_MODE=dev tsx scripts/dev-unified.ts",
    "build": "pnpm --dir apps/web build",
    "build:web": "pnpm --dir apps/web build",
    "account:create-super-admin": "tsx scripts/create-super-admin.ts",
    "account:create-super-admin:local": "node --env-file=.env.local --import tsx scripts/create-super-admin.ts",
    "demo:reset": "tsx scripts/reset-formal-demo-data.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "start": "UNIFIED_NEXT_MODE=start tsx scripts/dev-unified.ts",
    "start:candidate": "UNIFIED_NEXT_MODE=start UNIFIED_APP_PORT=3220 UNIFIED_DATABASE_PORT=55433 UNIFIED_APP_ORIGIN=http://127.0.0.1:3220 tsx scripts/dev-unified.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "pnpm --dir apps/web typecheck",
    "test": "vitest run",
    "test:web:collaboration": "pnpm --dir apps/web test:collaboration",
    "test:web:unit": "pnpm --dir apps/web test:unit",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "argon2": "0.45.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "0.414.0",
    "next": "16.3.2",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.7",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "drizzle-kit": "0.31.10",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "9.39.5",
    "eslint-config-next": "^16.3.2",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
